mdp

const int H = 12;

module adaptation
  t : [0..H] init 0;
  b : [0..4] init 4;
  p : [0..4] init 0;
  c : [0..1] init 0;
  [aggressive] t<H & b>0 & p<4 -> 0.140400:(t'=t+1)&(b'=b-1)&(p'=min(p+1,4))&(c'=1-c) + 0.561600:(t'=t+1)&(b'=b-1)&(p'=min(p+1,4))&(c'=c) + 0.015600:(t'=t+1)&(b'=b-1)&(p'=p)&(c'=1-c) + 0.062400:(t'=t+1)&(b'=b-1)&(p'=p)&(c'=c) + 0.039600:(t'=t+1)&(b'=b)&(p'=min(p+1,4))&(c'=1-c) + 0.158400:(t'=t+1)&(b'=b)&(p'=min(p+1,4))&(c'=c) + 0.004400:(t'=t+1)&(b'=b)&(p'=p)&(c'=1-c) + 0.017600:(t'=t+1)&(b'=b)&(p'=p)&(c'=c);
  [balanced] t<H & b>0 & p<4 -> 0.050000:(t'=t+1)&(b'=b-1)&(p'=min(p+1,4))&(c'=1-c) + 0.200000:(t'=t+1)&(b'=b-1)&(p'=min(p+1,4))&(c'=c) + 0.050000:(t'=t+1)&(b'=b-1)&(p'=p)&(c'=1-c) + 0.200000:(t'=t+1)&(b'=b-1)&(p'=p)&(c'=c) + 0.050000:(t'=t+1)&(b'=b)&(p'=min(p+1,4))&(c'=1-c) + 0.200000:(t'=t+1)&(b'=b)&(p'=min(p+1,4))&(c'=c) + 0.050000:(t'=t+1)&(b'=b)&(p'=p)&(c'=1-c) + 0.200000:(t'=t+1)&(b'=b)&(p'=p)&(c'=c);
  [cautious] t<H & b>0 & p<4 -> 0.022800:(t'=t+1)&(b'=b-1)&(p'=min(p+1,4))&(c'=1-c) + 0.091200:(t'=t+1)&(b'=b-1)&(p'=min(p+1,4))&(c'=c) + 0.091200:(t'=t+1)&(b'=b-1)&(p'=p)&(c'=1-c) + 0.364800:(t'=t+1)&(b'=b-1)&(p'=p)&(c'=c) + 0.017200:(t'=t+1)&(b'=b)&(p'=min(p+1,4))&(c'=1-c) + 0.068800:(t'=t+1)&(b'=b)&(p'=min(p+1,4))&(c'=c) + 0.068800:(t'=t+1)&(b'=b)&(p'=p)&(c'=1-c) + 0.275200:(t'=t+1)&(b'=b)&(p'=p)&(c'=c);
  [eco] t<H & b>0 & p<4 -> 0.013200:(t'=t+1)&(b'=b-1)&(p'=min(p+1,4))&(c'=1-c) + 0.052800:(t'=t+1)&(b'=b-1)&(p'=min(p+1,4))&(c'=c) + 0.030800:(t'=t+1)&(b'=b-1)&(p'=p)&(c'=1-c) + 0.123200:(t'=t+1)&(b'=b-1)&(p'=p)&(c'=c) + 0.046800:(t'=t+1)&(b'=b)&(p'=min(p+1,4))&(c'=1-c) + 0.187200:(t'=t+1)&(b'=b)&(p'=min(p+1,4))&(c'=c) + 0.109200:(t'=t+1)&(b'=b)&(p'=p)&(c'=1-c) + 0.436800:(t'=t+1)&(b'=b)&(p'=p)&(c'=c);
endmodule

label "done" = p=4;
label "battery_empty" = b=0 & p<4;
label "missed" = t=H & b>0 & p<4;

